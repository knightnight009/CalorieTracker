@{ ViewData["Title"] = "Calorie & macro tracking"; }
<section class="hero">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge rounded-pill text-bg-light border mb-3"><i class="bi bi-stars me-1"></i>AI-assisted food logging</span>
            <h1>Know what you eat, without the guesswork.</h1>
            <p class="lead text-muted mt-3">Snap a photo of your meal, review the estimate, and see how your calories, protein, carbs and fat line up with targets built from your own profile.</p>
            <div class="d-flex gap-2 mt-4">
                <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Create a free account</a>
                <a class="btn btn-outline-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">Log in</a>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-4">
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <div class="ring" style="--p: 68"><div><div class="ring-value tabular">1,412</div><div class="small text-muted">of 2,080 kcal</div></div></div>
                    <div class="flex-grow-1 d-grid gap-3" style="min-width: 200px">
                        <partial name="_MacroBar" model='new MacroBarModel("Protein", "n-protein", new RemainingAmount(140, 95), "g")' />
                        <partial name="_MacroBar" model='new MacroBarModel("Carbs", "n-carbs", new RemainingAmount(220, 140), "g")' />
                        <partial name="_MacroBar" model='new MacroBarModel("Fat", "n-fat", new RemainingAmount(70, 48), "g")' />
                    </div>
                </div>
                <p class="small text-muted mt-3 mb-0">Example view</p>
            </div>
        </div>
    </div>
</section>
<section class="row g-4 py-4">
    @foreach (var (icon, color, title, text) in new[]
    {
        ("bi-camera", "n-protein", "Photo food scanner", "Each item on the plate is estimated separately, and you edit before anything is saved."),
        ("bi-calculator", "n-cal", "Targets from your profile", "BMR (Mifflin-St Jeor), TDEE and macro targets, with clear explanations and safe defaults."),
        ("bi-graph-up", "n-carbs", "Trends, not noise", "Weekly averages and weight trends so a single day never tells the whole story."),
    })
    {
        <div class="col-md-4">
            <div class="card h-100 p-4 @color">
                <div class="feature-icon n-icon mb-3"><i class="bi @icon"></i></div>
                <h2 class="h5">@title</h2>
                <p class="text-muted mb-0">@text</p>
            </div>
        </div>
    }
</section>
