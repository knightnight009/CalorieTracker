@model string
@{ ViewData["Title"] = "Something went wrong"; }
<div class="auth-wrap text-center">
    <i class="bi bi-exclamation-octagon display-5 text-danger" aria-hidden="true"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">The error has been logged. Please try again. If it keeps happening, mention this reference: <code>@Model</code></p>
    <a class="btn btn-primary" href="/">Go to the home page</a>
</div>
