<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · NutriTrack" : "NutriTrack")</title>
    <meta name="theme-color" content="#0f8a6a" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.classList.add('js');</script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="app-sidebar d-none d-lg-flex" aria-label="Main navigation">
            <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-activity"></i></span> NutriTrack</a>
            <partial name="_NavLinks" />
            <div class="sidebar-footer">
                <div class="text-muted small text-truncate mb-2" title="@User.Identity.Name"><i class="bi bi-person-circle me-1"></i>@User.Identity.Name</div>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-box-arrow-right me-1"></i>Log out</button>
                </form>
            </div>
        </aside>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel" style="width: 280px">
            <div class="offcanvas-header">
                <span class="brand" id="mobileNavLabel"><span class="brand-mark"><i class="bi bi-activity"></i></span> NutriTrack</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column">
                <partial name="_NavLinks" />
                <div class="sidebar-footer">
                    <div class="text-muted small text-truncate mb-2">@User.Identity.Name</div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Log out</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="app-main">
            <header class="app-topbar d-lg-none">
                <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-activity"></i></span> NutriTrack</a>
                <button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Open menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </header>
            <main id="main" class="app-content" tabindex="-1">
                <partial name="_Flash" />
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <header class="app-topbar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-activity"></i></span> NutriTrack</a>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Log in</a>
                <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
            </div>
        </header>
        <main id="main" class="container py-3" tabindex="-1">
            <partial name="_Flash" />
            @RenderBody()
        </main>
        <footer class="container py-4 text-muted small">
            Nutrition numbers in this app are estimates. <a asp-controller="Home" asp-action="Privacy">Privacy &amp; data</a>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
