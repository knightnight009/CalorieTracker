# Copy to .env (never commit .env). Placeholders only.
# ASP.NET Core reads these names directly from environment variables.

# --- Required ---
# Neon gives a URL like postgresql://USER:PASSWORD@HOST/DB?sslmode=require. Either that or the Npgsql
# key/value form works:
ConnectionStrings__DefaultConnection=Host=YOUR-NEON-HOST.neon.tech;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Maximum Pool Size=10

# --- AI food scanner (optional; the app runs without it) ---
AI_PROVIDER=gemini                 # gemini | ollama: which configured provider to try first
AI_API_KEY=                        # Google AI Studio API key for Gemini
AI_MODEL=gemini-3.5-flash          # any Gemini model with image input; older models get retired for new keys
AI_TIMEOUT_SECONDS=60
AI_SCANS_PER_MINUTE=6              # per-user rate limit
OLLAMA_BASE_URL=                   # e.g. http://localhost:11434 (local, free)
OLLAMA_MODEL=qwen2.5vl:7b

# --- USDA FoodData Central search (optional) ---
USDA_API_KEY=                      # free key from https://fdc.nal.usda.gov/api-key-signup

# --- Email for confirmation / password reset (required in Production unless confirmation is disabled) ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=NutriTrack <no-reply@your-verified-domain.com>

# --- Account settings ---
Auth__RequireConfirmedEmail=true
Auth__RegistrationEnabled=true     # set false after your accounts are created
AUTH_POSTS_PER_MINUTE=10           # per-IP limit on login/register/reset posts

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
# PORT is set by Render automatically.
